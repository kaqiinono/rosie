{
  "name": "rosie",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev",
    "fresh": "pnpm --filter web fresh",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint && node scripts/check-theme-boundaries.mjs",
    "lint:theme": "node scripts/check-theme-boundaries.mjs",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "flipbook:sync": "node scripts/generate-flipbook-sync.mjs",
    "ai:sync-db": "node scripts/ai-sync-db.mjs",
    "ai:sync-catalog": "node scripts/ai-sync-catalog.mjs",
    "ai:sync-status": "node scripts/ai-sync-status.mjs",
    "ai:audit": "node scripts/ai-audit.mjs",
    "ai:sync-all": "node scripts/ai-sync-all.mjs",
    "grammar:extract": "node scripts/extract-grammar-unit.mjs",
    "grammar:render-pdf": "node scripts/extract-grammar-pdf.mjs",
    "migrate:math-summary-images": "node scripts/migrate-lesson-summary-images.mjs",
    "calc:audit": "node --import jiti/register scripts/calc-audit.ts",
    "calc:progress": "node --import jiti/register scripts/calc-progress-maintenance.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "jiti": "^2.6.1",
    "turbo": "^2.3.3",
    "typescript": "^5.8.2"
  }
}
